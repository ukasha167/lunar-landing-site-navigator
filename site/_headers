# Cache rules for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# GitHub Pages ignores this file.

# The version is in the folder name, so these files never change.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Maps, site data and scripts can change between deploys without a new name.
# A returning visitor reuses them for 1 hour, then the browser asks again.
/assets/*
  Cache-Control: public, max-age=3600

/data/*
  Cache-Control: public, max-age=3600

/lib/*
  Cache-Control: public, max-age=3600
